+/// Wait until the node's address book lists the other node as interested in the topic.
+async fn learns_interest(node: &TestNode, other: NodeId, topic: Topic) {
+    let mut interested = node.address_book.watch_topic(topic, false).await.unwrap();
+    while let Some(update) = interested.recv().await {
+        if update.value.contains(&other) {
+            return;
+        }
+    }
+}
