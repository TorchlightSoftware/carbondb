+#[tokio::test]
+async fn subscribing_to_a_topic_checks_in_with_known_nodes() {
+    setup_logging();
+
+    // Alice and Bob know each other's addresses, as after an earlier discovery session or a
+    // shared topic, but neither runs random walkers.
+    let mut alice = without_walkers([20; 32]).await;
+    let mut bob = without_walkers([21; 32]).await;
+    alice
+        .address_book
+        .insert_node_info(bob.node_info())
+        .await
+        .unwrap();
+    bob.address_book
+        .insert_node_info(alice.node_info())
+        .await
+        .unwrap();
+
+    // Alice is interested in a topic, then Bob subscribes to it too.
+    let topic: Topic = [1; 32].into();
+    alice
+        .address_book
+        .add_topic(alice.node_id(), topic)
+        .await
+        .unwrap();
+    bob.address_book
+        .add_topic(bob.node_id(), topic)
+        .await
+        .unwrap();
+
+    // Bob compares his new topic with Alice at once, and both learn they share it.
+    let wait = Duration::from_secs(5);
+    timeout(wait, learns_interest(&bob, alice.node_id(), topic))
+        .await
+        .expect("bob learns alice is interested in the topic");
+    timeout(wait, learns_interest(&alice, bob.node_id(), topic))
+        .await
+        .expect("alice learns bob is interested in the topic");
+}
